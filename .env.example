# =====================================================
# TarimCRM - Ortam Degiskenleri Sablonu
# =====================================================
# Kullanim: Bu dosyayi .env.local olarak kopyala ve degerleri doldur
#   cp .env.example .env.local   (Mac/Linux)
#   copy .env.example .env.local (Windows CMD)
#
# .env.local Git'e GITMEZ. Her makineye ayri ayri olusturulur.
# =====================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Veritabani (Supabase PostgreSQL) ---
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# --- Auth ---
# openssl rand -base64 32 (Mac) / [Guid]::NewGuid() (Windows PS) ile uret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Hava Durumu ---
OPENWEATHERMAP_API_KEY=

# --- AI (Akilli Asistan - opsiyonel) ---
ANTHROPIC_API_KEY=

# --- Uygulama ---
NODE_ENV=development
PORT=3000
