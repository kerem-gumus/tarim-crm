  mesajlar        AsistanMesaj[]
  tokenKullanim   TokenKullanim[]

  @@map("asistan_sohbetler")
}

model AsistanMesaj {
  id              String    @id @default(uuid())
  sohbetId        String    @map("sohbet_id")
