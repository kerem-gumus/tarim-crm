// =====================================================
// TarimCRM Prisma Schema
// =====================================================
// Bu dosya tum tablo iskeletlerini icerir.
// Her modul kendi modellerini yatay-prisma agent'i araciligiyla
// genisletecek. Iliskileri bozmadan, sadece eksik alanlari ekleyelim.
//
// Kurallar (CLAUDE.md'den):
// - Model isimleri PascalCase, Turkce (HasatGirisi, IsciEkibi)
// - Field isimleri camelCase, Turkce (tartimMiktariKg)
// - Tablo isimleri @@map ile snake_case Turkce (hasat_girisleri)
// - Column isimleri @map ile snake_case (tartim_miktari_kg)
// - Enum degerleri snake_case ASCII (ton_isi, odeme_bekleniyor)
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// MODUL 1 - HASAT YONETIMI
// =====================================================

model HasatDonemi {
  id               String    @id @default(uuid())
  donemAdi         String    @map("donem_adi")
  yil              Int
  baslangicTarihi  DateTime  @map("baslangic_tarihi") @db.Date
  bitisTarihi      DateTime? @map("bitis_tarihi") @db.Date
  durum            DonemDurumu @default(aktif)
  brutFiyat        Decimal?  @map("brut_fiyat") @db.Decimal(10, 4)         // Yaş çay brüt kg fiyatı
  netFiyat         Decimal?  @map("net_fiyat") @db.Decimal(10, 4)          // Yaş çay net kg fiyatı
  desteklemeMiktari     Decimal?    @map("destekleme_miktari") @db.Decimal(10, 4)       // Devlet destekleme birim fiyatı (₺/kg)
  toplamHasatKg         Decimal?    @map("toplam_hasat_kg") @db.Decimal(14, 2)          // Dönem kapanışında hesaplanan toplam hasat
  desteklemeAlacakTutar Decimal?    @map("destekleme_alacak_tutar") @db.Decimal(14, 2)  // toplamHasatKg × desteklemeMiktari
  desteklemeOdemeDurumu OdemeDurumu? @map("destekleme_odeme_durumu")                    // Devlet ödeme durumu
  desteklemeOdenenTutar Decimal     @default(0) @map("destekleme_odenen_tutar") @db.Decimal(14, 2)
  desteklemeKalanTutar  Decimal?    @map("destekleme_kalan_tutar") @db.Decimal(14, 2)
  olusturmaTarihi  DateTime  @default(now()) @map("olusturma_tarihi")
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  surgunler           Surgun[]
  donemCiftciler      HasatDonemCiftci[]
  budamaBilgileri     BudamaBilgisi[]
  kesintiler          HasatDonemKesinti[]
  desteklemeOdemeler  DesteklemeOdeme[]

  @@map("hasat_donemleri")
}

model HasatDonemKesinti {
  id            String    @id @default(uuid())
  hasatDonemiId String    @map("hasat_donemi_id")
  kesintiAdi    String    @map("kesinti_adi")       // örn: "Çay-Kur Kesintisi", "Kooperatif Aidatı"
  yuzde         Decimal   @db.Decimal(6, 4)         // örn: 2.5000 → %2.5
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  olusturanId   String?   @map("olusturan_id")
  olusturanAdi  String?   @map("olusturan_adi")
  aktif         Boolean   @default(true)

  hasatDonemi   HasatDonemi @relation(fields: [hasatDonemiId], references: [id])

  @@map("hasat_donem_kesintiler")
}

model HasatDonemCiftci {
  id              String    @id @default(uuid())
  hasatDonemiId   String    @map("hasat_donemi_id")
  ciftciId        String    @map("ciftci_id")
  toplamDonum     Decimal?  @map("toplam_donum") @db.Decimal(10, 2)  // Ciftcinin o donemki toplam donumu (tarlalardan)
  olusturmaTarihi DateTime  @default(now()) @map("olusturma_tarihi")
  olusturanId     String?   @map("olusturan_id")
  olusturanAdi    String?   @map("olusturan_adi")
  aktif           Boolean   @default(true)

  hasatDonemi     HasatDonemi @relation(fields: [hasatDonemiId], references: [id])
  ciftci          Ciftci      @relation(fields: [ciftciId], references: [id])
  budamaBilgisi   BudamaBilgisi?

  @@unique([hasatDonemiId, ciftciId])
  @@map("hasat_donem_ciftciler")
}

model BudamaBilgisi {
  id                  String      @id @default(uuid())
  hasatDonemiId       String      @map("hasat_donemi_id")
  donemCiftciId       String      @unique @map("donem_ciftci_id")
  ciftciId            String      @map("ciftci_id")
  toplamDonum         Decimal     @map("toplam_donum") @db.Decimal(10, 2)     // Ciftcinin toplam donumu
  budananDonum        Decimal     @map("budanan_donum") @db.Decimal(10, 4)   // Devlet kurali ile hesaplanan budana dönüm
  budananM2           Decimal     @map("budanan_m2") @db.Decimal(12, 2)      // budananDonum x 1000 (metrekare)
  brutFiyat           Decimal     @map("brut_fiyat") @db.Decimal(10, 4)      // O yilin brut kg fiyati
  hesaplananTutar     Decimal     @map("hesaplanan_tutar") @db.Decimal(14, 2) // budananM2 x brutFiyat
  odemeDurumu         OdemeDurumu @default(odeme_bekleniyor) @map("odeme_durumu")
  odenenTutar         Decimal     @default(0) @map("odenen_tutar") @db.Decimal(14, 2)
  kalanTutar          Decimal     @map("kalan_tutar") @db.Decimal(14, 2)
  notlar              String?
  olusturmaTarihi     DateTime    @default(now()) @map("olusturma_tarihi")
  olusturanId         String?     @map("olusturan_id")
  olusturanAdi        String?     @map("olusturan_adi")
  guncelleyenId       String?     @map("guncelleyen_id")
  guncelleyenAdi      String?     @map("guncelleyen_adi")
  guncellemeTarihi    DateTime?   @map("guncelleme_tarihi")
  aktif               Boolean     @default(true)

  hasatDonemi   HasatDonemi      @relation(fields: [hasatDonemiId], references: [id])
  donemCiftci   HasatDonemCiftci @relation(fields: [donemCiftciId], references: [id])
  ciftci        Ciftci           @relation(fields: [ciftciId], references: [id])
  odemeler      BudamaOdeme[]

  @@map("budama_bilgileri")
}

model DesteklemeOdeme {
  id              String    @id @default(uuid())
  hasatDonemiId   String    @map("hasat_donemi_id")
  tutar           Decimal   @db.Decimal(14, 2)
  tarih           DateTime  @db.Date
  aciklama        String?
  olusturmaTarihi DateTime  @default(now()) @map("olusturma_tarihi")
  olusturanId     String?   @map("olusturan_id")
  olusturanAdi    String?   @map("olusturan_adi")
  aktif           Boolean   @default(true)

  hasatDonemi     HasatDonemi @relation(fields: [hasatDonemiId], references: [id])

  @@map("destekleme_odemeler")
}

model BudamaOdeme {
  id              String    @id @default(uuid())
  budamaBilgisiId String    @map("budama_bilgisi_id")
  tutar           Decimal   @db.Decimal(14, 2)
  tarih           DateTime  @db.Date
  aciklama        String?
  olusturmaTarihi DateTime  @default(now()) @map("olusturma_tarihi")
  olusturanId     String?   @map("olusturan_id")
  olusturanAdi    String?   @map("olusturan_adi")
  aktif           Boolean   @default(true)

  budamaBilgisi   BudamaBilgisi @relation(fields: [budamaBilgisiId], references: [id])

  @@map("budama_odemeler")
}

model Surgun {
  id               String    @id @default(uuid())
  hasatDonemiId    String    @map("hasat_donemi_id")
  surgunNo         Int       @map("surgun_no")
  surgunAdi        String    @map("surgun_adi")
  baslangicTarihi  DateTime  @map("baslangic_tarihi") @db.Date
  bitisTarihi      DateTime? @map("bitis_tarihi") @db.Date
  durum            DonemDurumu @default(aktif)
  toplamHasatKg    Decimal   @default(0) @map("toplam_hasat_kg") @db.Decimal(12, 2)
  toplamTutar      Decimal   @default(0) @map("toplam_tutar") @db.Decimal(14, 2)
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  hasatDonemi      HasatDonemi @relation(fields: [hasatDonemiId], references: [id])
  hasatGirisleri   HasatGirisi[]
  kontenjanlar     Kontenjan[]
  gelirKayitlari   GelirKaydi[]

  @@map("surgunler")
}

model HasatGirisi {
  id                  String   @id @default(uuid())
  surgunId            String   @map("surgun_id")
  tarih               DateTime @db.Date
  tarlaId             String?  @map("tarla_id")          // Kontenjan modunda opsiyonel
  tartimMiktariKg     Decimal  @map("tartim_miktari_kg") @db.Decimal(10, 2)
  satisMiktariKg      Decimal  @map("satis_miktari_kg") @db.Decimal(10, 2)
  toplanmaTuru        ToplanmaTuru @map("toplanma_turu")
  isciEkipId          String?  @map("isci_ekip_id")
  odemeTuru           OdemeTuru? @map("odeme_turu")
  tonFiyati           Decimal? @map("ton_fiyati") @db.Decimal(10, 2)
  yevmiyeFiyati       Decimal? @map("yevmiye_fiyati") @db.Decimal(10, 2)
  iscilikToplamTutar  Decimal? @map("iscilik_toplam_tutar") @db.Decimal(12, 2)
  musteriId           String   @map("musteri_id")
  // Satış fiyatı (sadece özel/kurumsal müşterilerde doldurulur)
  fiyatTuru           FiyatTuru? @map("fiyat_turu")                              // devlet_fiyati veya ozel_fiyat
  satisKgFiyati       Decimal?  @map("satis_kg_fiyati") @db.Decimal(10, 4)       // ₺/kg
  satisToplam         Decimal?  @map("satis_toplam") @db.Decimal(14, 2)          // satisMiktariKg × satisKgFiyati
  odemeSekli          OdemeSekli? @map("odeme_sekli")                            // pesin veya vadeli
  odemeTarihi         DateTime? @map("odeme_tarihi") @db.Date                    // peşin: ödeme günü, vadeli: vade tarihi
  kontenjanId         String?  @map("kontenjan_id")          // Kontenjan modunda dolu
  aciklama            String?                                // Özellik #B: listede gösterilir
  // Cüzdan kullandırma alanları (null = "kendim")
  cuzdanKullaniciId   String?  @map("cuzdan_kullanici_id")   // Kimin adına yapıldı
  satisBenimMi        Boolean? @map("satis_benim_mi")        // true=Senaryo1 ben yaptım, false=Senaryo2 o yaptı
  cariMiktarKg        Decimal? @map("cari_miktar_kg") @db.Decimal(10, 2) // Senaryo1: toplam içinden cari hesaba düşülecek kg
  notlar              String?
  olusturmaTarihi     DateTime @default(now()) @map("olusturma_tarihi")
  olusturanId         String?  @map("olusturan_id")
  olusturanAdi        String?  @map("olusturan_adi")
  guncelleyenId       String?  @map("guncelleyen_id")
  guncelleyenAdi      String?  @map("guncelleyen_adi")
  guncellemeTarihi    DateTime? @map("guncelleme_tarihi")
  aktif               Boolean  @default(true)

  surgun              Surgun    @relation(fields: [surgunId], references: [id])
  tarla               Tarla?    @relation(fields: [tarlaId], references: [id])
  isciEkip            IsciEkibi? @relation(fields: [isciEkipId], references: [id])
  musteri             Musteri   @relation(fields: [musteriId], references: [id])
  kontenjan           Kontenjan? @relation(fields: [kontenjanId], references: [id])
  cuzdanKullanici     CuzdanKullanicisi? @relation(fields: [cuzdanKullaniciId], references: [id])
  cayKalite           CayKalite[]
  kontenjanTakip      KontenjanGunlukTakip[]
  cariHareketler      CariHareket[]
  gelirKayitlari      GelirKaydi[]

  @@map("hasat_girisleri")
}

// =====================================================
// MODUL 2 - ISCILIK VE EKIP YONETIMI
// =====================================================

model Isci {
  id               String    @id @default(uuid())
  adSoyad          String    @map("ad_soyad")
  tcNo             String?   @map("tc_no")
  telefon          String
  adres            String?
  bankaIban        String?   @map("banka_iban")
  acilIletisim     String?   @map("acil_iletisim")
  notlar           String?
  durum            AktifPasif @default(aktif)
  kayitTarihi      DateTime  @default(now()) @map("kayit_tarihi")
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  ekipUyelikleri   EkipIsciIliskisi[]

  @@map("isciler")
}

model IsciEkibi {
  id               String    @id @default(uuid())
  ekipAdi          String    @map("ekip_adi")
  ekipBasiId       String?   @map("ekip_basi_id")
  durum            AktifPasif @default(aktif)
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  uyeler           EkipIsciIliskisi[]
  hasatGirisleri   HasatGirisi[]

  @@map("isci_ekipleri")
}

model EkipIsciIliskisi {
  ekipId          String    @map("ekip_id")
  isciId          String    @map("isci_id")
  katilmaTarihi   DateTime  @default(now()) @map("katilma_tarihi") @db.Date
  ayrilmaTarihi   DateTime? @map("ayrilma_tarihi") @db.Date

  ekip            IsciEkibi @relation(fields: [ekipId], references: [id])
  isci            Isci      @relation(fields: [isciId], references: [id])

  @@id([ekipId, isciId])
  @@map("ekip_isci_iliskisi")
}

// =====================================================
// MODUL 3 - TARLA YONETIMI
// =====================================================

model Tarla {
  id               String    @id @default(uuid())
  tarlaAdi         String    @map("tarla_adi")
  konumIl          String    @map("konum_il")
  konumIlce        String    @map("konum_ilce")
  konumKoy         String    @map("konum_koy")
  adaNo            String?   @map("ada_no")
  parselNo         String?   @map("parsel_no")
  donum            Decimal   @db.Decimal(10, 2)
  metrekare        Decimal?  @db.Decimal(12, 2)
  rakim            Int?
  cayCesidi        String?   @map("cay_cesidi")
  dikimYili        Int?      @map("dikim_yili")
  topraktipi       String?   @map("toprak_tipi")
  sulamaDurumu     SulamaDurumu @map("sulama_durumu")
  ciftciId         String?   @map("ciftci_id")
  mulkiyetDurumu   MulkiyetDurumu @default(sahip) @map("mulkiyet_durumu")  // sahip mi kiracı mı
  kiraciCiftciId   String?   @map("kiraci_ciftci_id")   // kiralıksa kiracı çiftçi (ciftci.id)
  koordinatLat     Decimal?  @map("koordinat_lat") @db.Decimal(10, 7)
  koordinatLng     Decimal?  @map("koordinat_lng") @db.Decimal(10, 7)
  durum            AktifPasif @default(aktif)
  notlar           String?
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  ciftci           Ciftci?   @relation(fields: [ciftciId], references: [id])
  hasatGirisleri   HasatGirisi[]
  havaVerileri     HavaVerisi[]
  cayKalite        CayKalite[]
  toprakNumuneler  ToprakNumune[]

  @@map("tarlalar")
}

// =====================================================
// MODUL 4 - CIFTCI YONETIMI
// =====================================================

model Ciftci {
  id               String    @id @default(uuid())
  adSoyad          String    @map("ad_soyad")
  tcNo             String?   @map("tc_no")
  telefon          String
  telefon2         String?   @map("telefon_2")
  adres            String?
  il               String?
  ilce             String?
  koy              String?
  cayKurNo         String?   @map("cay_kur_no")
  bankaIban        String?   @map("banka_iban")
  vergiNo          String?   @map("vergi_no")
  durum            AktifPasif @default(aktif)
  notlar           String?
  kayitTarihi      DateTime  @default(now()) @map("kayit_tarihi")
  olusturanId      String?   @map("olusturan_id")
  olusturanAdi     String?   @map("olusturan_adi")
  guncelleyenId    String?   @map("guncelleyen_id")
  guncelleyenAdi   String?   @map("guncelleyen_adi")
  guncellemeTarihi DateTime? @map("guncelleme_tarihi")
  aktif            Boolean   @default(true)

  tarlalar         Tarla[]
  donemler         HasatDonemCiftci[]
  budamaBilgileri  BudamaBilgisi[]

  @@map("ciftciler")
}

// =====================================================
// MODUL 5 - MUSTERI YONETIMI
// =====================================================

model Musteri {
  id                String    @id @default(uuid())
  musteriAdi        String    @map("musteri_adi")
  musteriTipi       MusteriTipi @map("musteri_tipi")
  kurumsalMi        Boolean   @default(false) @map("kurumsal_mi")
  devletMi          Boolean   @default(false) @map("devlet_mi")
  kurumAdi          String?   @map("kurum_adi")
  yetkiliKisi       String?   @map("yetkili_kisi")
  telefon           String
  email             String?
  adres             String?
  vergiDairesi      String?   @map("vergi_dairesi")
  vergiNo           String?   @map("vergi_no")
  odemeVadeGun      Int       @default(0) @map("odeme_vade_gun")
  kontenjanVarMi    Boolean   @default(false) @map("kontenjan_var_mi")
  durum             AktifPasif @default(aktif)
  notlar            String?
  olusturanId       String?   @map("olusturan_id")
  olusturanAdi      String?   @map("olusturan_adi")
  guncelleyenId     String?   @map("guncelleyen_id")
  guncelleyenAdi    String?   @map("guncelleyen_adi")
  guncellemeTarihi  DateTime? @map("guncelleme_tarihi")
  aktif             Boolean   @default(true)

  hasatGirisleri    HasatGirisi[]
  kontenjanlar      Kontenjan[]

  @@map("musteriler")
}

// =====================================================
// MODUL 6 - KONTENJAN VE SATIS
// =====================================================

model Kontenjan {
  id                  String    @id @default(uuid())
  surgunId            String    @map("surgun_id")
  musteriId           String    @map("musteri_id")
  baslangicTarihi     DateTime  @map("baslangic_tarihi") @db.Date
  bitisTarihi         DateTime? @map("bitis_tarihi") @db.Date
  gunlukKontenjanKg   Decimal   @map("gunluk_kontenjan_kg") @db.Decimal(10, 2)
  durum               DonemDurumu @default(aktif)
  olusturanId         String?   @map("olusturan_id")
  olusturanAdi        String?   @map("olusturan_adi")
  guncelleyenId       String?   @map("guncelleyen_id")
  guncelleyenAdi      String?   @map("guncelleyen_adi")
  guncellemeTarihi    DateTime? @map("guncelleme_tarihi")
  aktif               Boolean   @default(true)

  surgun              Surgun    @relation(fields: [surgunId], references: [id])
  musteri             Musteri   @relation(fields: [musteriId], references: [id])
  gunlukTakip         KontenjanGunlukTakip[]
  hasatGirisleri      HasatGirisi[]

  @@map("kontenjanlar")
}

model KontenjanGunlukTakip {
  id                  String    @id @default(uuid())
  kontenjanId         String    @map("kontenjan_id")
  hasatGirisId        String?   @map("hasat_girisi_id")  // Her hasat girişine 1 takip kaydı
  tarih               DateTime  @db.Date
  tartimKg            Decimal   @map("tartim_kg") @db.Decimal(10, 2)
  gunlukKontenjanKg   Decimal   @map("gunluk_kontenjan_kg") @db.Decimal(10, 2)
  oncekiBakiyeKg      Decimal   @map("onceki_bakiye_kg") @db.Decimal(10, 2)
  hesaplananSatisKg   Decimal   @map("hesaplanan_satis_kg") @db.Decimal(10, 2)  // Günlük satış miktarı
  kalanBakiyeKg       Decimal   @map("kalan_bakiye_kg") @db.Decimal(10, 2)
  olusturmaTarihi     DateTime  @default(now()) @map("olusturma_tarihi")        // Zincir sırası için
  olusturanId         String?   @map("olusturan_id")
  olusturanAdi        String?   @map("olusturan_adi")
  guncelleyenId       String?   @map("guncelleyen_id")
  guncelleyenAdi      String?   @map("guncelleyen_adi")
  guncellemeTarihi    DateTime? @map("guncelleme_tarihi")
  aktif               Boolean   @default(true)

  kontenjan           Kontenjan   @relation(fields: [kontenjanId], references: [id])
  hasatGirisi         HasatGirisi? @relation(fields: [hasatGirisId], references: [id])

  @@map("kontenjan_gunluk_takip")
}

// =====================================================
// MODUL 7 - FINANS VE ODEME
// =====================================================

model GelirKaydi {
  id                String    @id @default(uuid())
  surgunId          String    @map("surgun_id")
  hasatGirisiId     String?   @map("hasat_girisi_id")    // hasat girişinden oluşan alacak
  musteriId         String?   @map("musteri_id")
  musteriAdi        String?   @map("musteri_adi")        // Görüntüleme için
  fiyatTuru         FiyatTuru? @map("fiyat_turu")        // devlet_fiyati veya ozel_fiyat
  ay                Int?                                  // 1-12 (aylık gruplama)
  yil               Int?                                  // ödeme yılı
  toplamKg          Decimal   @map("toplam_kg") @db.Decimal(12, 2)
  birimFiyat        Decimal   @map("birim_fiyat") @db.Decimal(10, 4)
  toplamTutar       Decimal   @map("toplam_tutar") @db.Decimal(14, 2)
  odemeDurumu       OdemeDurumu @default(odeme_bekleniyor) @map("odeme_durumu")
